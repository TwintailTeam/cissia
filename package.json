{
    "name": "cissia",
    "version": "1.0.0",
    "description": "Themeable, dependency-light React UI component library for TwintailTeam applications.",
    "license": "GPL-3.0-or-later",
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "files": [
        "dist",
        "src/cissia.css"
    ],
    "main": "./dist/cissia.cjs",
    "module": "./dist/cissia.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/cissia.js",
            "require": "./dist/cissia.cjs"
        },
        "./styles.css": "./src/cissia.css",
        "./package.json": "./package.json"
    },
    "scripts": {
        "dev": "vite --config vite.playground.config.ts",
        "preview:build": "vite build --config vite.playground.config.ts",
        "preview": "vite preview --config vite.playground.config.ts",
        "build": "tsc -p tsconfig.build.json && vite build",
        "typecheck": "tsc --noEmit"
    },
    "peerDependencies": {
        "react": ">=18.3.0",
        "react-dom": ">=18.3.0"
    },
    "dependencies": {
        "@floating-ui/react": "^0.27.20",
        "framer-motion": "^13.1.1"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.4.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@typescript/typescript6": "^6.0.2",
        "@vitejs/plugin-react": "^6.1.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "tailwind-scrollbar": "^4.0.2",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.2.4",
        "vite-plugin-dts": "^5.1.0"
    },
    "keywords": [
        "react",
        "ui",
        "components",
        "design-system",
        "themeable"
    ]
}
